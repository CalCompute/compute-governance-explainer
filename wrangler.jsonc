{
  // Cloudflare Worker that serves the built explorer (dist/explorer/) at research.californiacompute.org/explorer/.
  // Cloudflare builds and deploys it from GitHub on every push to the branch set in the dashboard (build command: npm run build).
  // The route takes /explorer* on the Research Library's host; the library's own Worker serves everything else there.
  "name": "governance-explainer",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "html_handling": "auto-trailing-slash" },
  "routes": [{ "pattern": "research.californiacompute.org/explorer*", "zone_name": "californiacompute.org" }]
}
